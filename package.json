{
  "name": "kaiju-deepscope-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm compile && wxt build",
    "build:chrome": "pnpm compile && wxt build -b chrome",
    "zip": "pnpm compile && vitest run && wxt zip",
    "zip:chrome": "pnpm compile && vitest run && wxt zip -b chrome",
    "test": "vitest",
    "test:run": "vitest run",
    "compile": "tsc --noEmit",
    "check:release": "pnpm compile && vitest run && wxt build -b chrome",
    "release:zip": "pnpm zip:chrome",
    "bench": "vitest bench --run src/benchmarks/*.bench.ts",
    "postinstall": "wxt prepare",
    "bench:rules": "vitest bench --run src/benchmarks/rule-detection-profile.bench.ts",
    "bench:rules:wide": "KAIJU_DEEPSCOPE_RULE_BENCH_REGISTRY_SCAN=1 vitest bench --run src/benchmarks/rule-detection-profile.bench.ts",
    "bench:rules:gate": "KAIJU_DEEPSCOPE_RULE_BENCH_REGISTRY_SCAN=1 KAIJU_DEEPSCOPE_RULE_BENCH_GENERATED_PASS_SCAN=1 KAIJU_DEEPSCOPE_RULE_BENCH_FAIL_ON_BUDGET=1 vitest bench --run src/benchmarks/rule-detection-profile.bench.ts"
  },
  "dependencies": {
    "@corvu/calendar": "^0.1.2",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@dagrejs/graphlib": "^4.0.7",
    "@kobalte/core": "^0.13.14",
    "@logtape/logtape": "^2.4.2",
    "@solid-primitives/media": "^2.3.6",
    "@std/bytes": "npm:@jsr/std__bytes@^1.0.6",
    "@std/encoding": "npm:@jsr/std__encoding@^1.0.11",
    "@std/fmt": "npm:@jsr/std__fmt@^1.0.10",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-virtual": "^3.13.53",
    "class-variance-authority": "^0.7.1",
    "cmdk-solid": "^1.2.0",
    "cnfast": "^0.2.0",
    "comctx": "1.7.7",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "postcss-selector-parser": "^7.2.0",
    "shadcn": "^4.23.0",
    "solid-js": "1.9.18",
    "solid-sonner": "^0.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@iconify/json": "^2.2.555",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@wxt-dev/module-solid": "1.1.4",
    "fontless": "^1.3.4",
    "oxc-parser": "0.158.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "unplugin-icons": "^24.0.0",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
