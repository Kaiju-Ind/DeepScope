{
  "name": "deepscope",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "dev": "pnpm --filter @deepscope/extension dev",
    "build": "pnpm --filter @deepscope/extension build",
    "build:chrome": "pnpm --filter @deepscope/extension build:chrome",
    "zip": "pnpm --filter @deepscope/extension zip",
    "zip:chrome": "pnpm --filter @deepscope/extension zip:chrome",
    "zip:firefox": "pnpm --filter @deepscope/extension zip:firefox",
    "zip:safari": "pnpm --filter @deepscope/extension zip:safari",
    "test": "vitest",
    "test:run": "vitest run",
    "compile": "pnpm --filter \"./packages/*\" --filter \"./tools/*\" --fail-if-no-match run check && tsc --noEmit -p apps/extension && tsc --noEmit -p utils && tsc --noEmit -p .",
    "check:release": "pnpm compile && vitest run && pnpm --filter @deepscope/extension exec wxt build -b chrome",
    "release:zip": "pnpm zip:chrome",
    "bench": "pnpm --filter @deepscope/extension bench",
    "bench:rules": "pnpm --filter @deepscope/extension bench:rules",
    "bench:rules:wide": "pnpm --filter @deepscope/extension bench:rules:wide",
    "bench:rules:gate": "pnpm --filter @deepscope/extension bench:rules:gate",
    "validate:chrome-artifact": "node tools/verify/chrome.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
