#!/usr/bin/env bash
#MISE description="Zip each browser and write release-named archives plus SHA256SUMS"
#USAGE flag "--out <dir>" default=".output/release" help="Output directory (replaced; keep it under .output so WXT never packs it into the sources zip)"
#USAGE arg "[browser]..." help="Browsers to package (default: all)" {
#USAGE   choices "chrome" "firefox" "safari"
#USAGE }
set -euo pipefail
read -r -a browsers <<< "${usage_browser:-chrome firefox safari}"
for browser in "${browsers[@]}"; do
  mise run zip "$browser"
done
exec node scripts/release/archives.mjs collect --out "${usage_out:?}" "${browsers[@]}"
